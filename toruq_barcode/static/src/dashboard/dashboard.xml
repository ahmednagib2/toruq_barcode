<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="toruq_barcode.CountDashboard">
        <div class="o_tq_dash" dir="rtl" t-att-style="rootStyle">

            <div class="o_tq_hero">
                <div class="o_tq_brand">
                    <img t-if="company.logo" class="o_tq_logo" t-att-src="company.logo" alt=""/>
                    <div>
                        <h1 class="o_tq_title">لوحة الجرد والمخزون</h1>
                        <div class="o_tq_subtitle" t-out="subtitle"/>
                    </div>
                </div>
                <div class="o_tq_hero_actions">
                    <button type="button" class="o_tq_btn" t-on-click="() => this.load()">تحديث</button>
                    <button type="button" class="o_tq_btn" t-on-click="() => this.exportCsv()">تصدير Excel</button>
                    <button type="button" class="o_tq_btn" t-on-click="() => this.print()">طباعة</button>
                </div>
            </div>

            <div class="o_tq_filters">
                <div class="o_tq_chips">
                    <t t-foreach="periods" t-as="p" t-key="p.k">
                        <button type="button" t-att-class="periodClass(p.k)" t-on-click="() => this.setPeriod(p.k)" t-out="p.l"/>
                    </t>
                </div>
                <div class="o_tq_nav" t-if="!isCustom">
                    <button type="button" class="o_tq_navbtn" t-on-click="() => this.shift(1)">الفترة السابقة ›</button>
                    <span class="o_tq_range" t-out="rangeLabel"/>
                    <button type="button" class="o_tq_navbtn" t-att-disabled="cannotGoForward" t-on-click="() => this.shift(-1)">‹ التالية</button>
                </div>
                <div class="o_tq_nav" t-else="">
                    <input type="date" class="form-control" t-att-value="state.dateFrom" t-on-change="(ev) => this.onCustom('dateFrom', ev)"/>
                    <span>←</span>
                    <input type="date" class="form-control" t-att-value="state.dateTo" t-on-change="(ev) => this.onCustom('dateTo', ev)"/>
                </div>
                <select class="form-select o_tq_wh" t-on-change="onWarehouse">
                    <option value="">كل الفروع</option>
                    <t t-foreach="state.data ? state.data.warehouses : []" t-as="w" t-key="w.id">
                        <option t-att-value="w.id" t-att-selected="isSelectedWarehouse(w.id)" t-out="w.name"/>
                    </t>
                </select>
            </div>

            <div t-if="state.error" class="alert alert-danger" t-out="state.error"/>
            <div t-foreach="warnings" t-as="w" t-key="w_index" class="alert alert-warning o_tq_warn" t-out="w"/>
            <div t-if="state.loading and !hasData and !state.error" class="o_tq_loading">جاري التحميل…</div>

            <t t-if="hasData">
                <div class="o_tq_kpis">
                    <t t-foreach="kpis" t-as="k" t-key="k.key">
                        <button type="button" t-att-class="kpiClass(k)" t-on-click="() => this.setTab(k.tab)">
                            <span class="o_tq_kpi_label" t-out="k.label"/>
                            <span class="o_tq_kpi_value" t-out="k.value"/>
                            <span class="o_tq_kpi_sub" t-out="k.sub"/>
                        </button>
                    </t>
                </div>

                <div class="o_tq_tabs">
                    <t t-foreach="tabs" t-as="t" t-key="t.k">
                        <button type="button" t-att-class="tabClass(t.k)" t-on-click="() => this.setTab(t.k)" t-out="t.l"/>
                    </t>
                </div>

                <t t-if="isOverview">
                    <div class="o_tq_grid">
                        <section class="o_tq_card">
                            <h3>نسبة إنجاز الجرد</h3>
                            <div class="o_tq_donut" t-att-style="donutStyle"><span t-out="progressText"/></div>
                            <p class="o_tq_note">تم جرد <b t-out="fmt(state.data.kpis.applied)"/> مقابل <b t-out="fmt(state.data.kpis.due_total)"/> ما زال مطلوباً</p>
                            <p class="o_tq_note">دقة الجرد (مطابق للنظام): <b t-out="state.data.kpis.accuracy"/>%</p>
                        </section>

                        <section class="o_tq_card o_tq_wide">
                            <h3>نشاط الجرد خلال الفترة</h3>
                            <div class="o_tq_legend">
                                <span class="is-applied">معتمد</span>
                                <span class="is-submitted">مرسل للاعتماد</span>
                                <span class="is-requested">مطلوب</span>
                            </div>
                            <div class="o_tq_bars">
                                <t t-foreach="trend" t-as="b" t-key="b_index">
                                    <div class="o_tq_bar_col">
                                        <div class="o_tq_bar_group">
                                            <div class="o_tq_bar is-requested" t-att-style="barStyle(b.requested, trendMax)" t-att-title="b.requested"/>
                                            <div class="o_tq_bar is-submitted" t-att-style="barStyle(b.submitted, trendMax)" t-att-title="b.submitted"/>
                                            <div class="o_tq_bar is-applied" t-att-style="barStyle(b.applied, trendMax)" t-att-title="b.applied"/>
                                        </div>
                                        <span class="o_tq_bar_label" t-out="b.label"/>
                                    </div>
                                </t>
                            </div>
                        </section>

                        <section class="o_tq_card">
                            <h3>الإنجاز حسب الفرع</h3>
                            <div t-foreach="progressWh" t-as="w" t-key="w_index" class="o_tq_hbar">
                                <div class="o_tq_hbar_head"><span t-out="w.name"/><b><t t-out="w.done"/> / <t t-out="w.due + w.done"/></b></div>
                                <div class="o_tq_hbar_track"><div class="o_tq_hbar_fill" t-att-style="widthStyle(w.pct)"/></div>
                            </div>
                            <p t-if="!progressWh.length" class="o_tq_note">لا توجد بيانات للفروع في هذه الفترة.</p>
                        </section>

                        <section class="o_tq_card o_tq_wide">
                            <h3>أداء الموظفين</h3>
                            <div class="o_tq_table_wrap">
                                <table class="o_tq_table">
                                    <thead><tr><th>الموظف</th><th>طلب جرد</th><th>إرسال للاعتماد</th><th>اعتماد وتطبيق</th><th>إجمالي الفروقات</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="usersRows" t-as="u" t-key="u_index">
                                            <td t-out="u.user"/>
                                            <td class="o_tq_num" t-out="u.requested"/>
                                            <td class="o_tq_num" t-out="u.submitted"/>
                                            <td class="o_tq_num" t-out="u.applied"/>
                                            <td class="o_tq_num" t-out="fmt(u.diff)"/>
                                        </tr>
                                        <tr t-if="!usersRows.length"><td colspan="5" class="o_tq_empty">لا توجد أحداث في هذه الفترة.</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </div>
                </t>

                <t t-else="">
                    <div class="o_tq_toolbar">
                        <div class="o_tq_chips" t-if="isStock">
                            <t t-foreach="stockViews" t-as="v" t-key="v.k">
                                <button type="button" t-att-class="stockViewClass(v.k)" t-on-click="() => this.setStockView(v.k)" t-out="v.l"/>
                            </t>
                        </div>
                        <input type="search" class="form-control o_tq_search" placeholder="بحث في الجدول…" t-att-value="state.search" t-on-input="onSearch"/>
                        <span class="o_tq_count"><t t-out="table.rows.length"/> / <t t-out="table.total"/></span>
                    </div>
                    <div class="o_tq_table_wrap">
                        <table class="o_tq_table">
                            <thead>
                                <tr>
                                    <th t-foreach="table.cols" t-as="c" t-key="c.k" t-out="c.l"/>
                                    <th t-if="showCounted"/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="table.rows" t-as="r" t-key="r_index" class="o_tq_row" t-on-click="() => this.openProduct(r.product_id)">
                                    <td t-foreach="table.cols" t-as="c" t-key="c.k" t-att-class="cellClass(r, c)" t-out="cellText(r, c)"/>
                                    <td t-if="showCounted" class="o_tq_actions">
                                        <button type="button" class="btn btn-sm btn-success" t-att-disabled="state.busy" t-on-click.stop="() => this.approve(r)">اعتماد</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" t-att-disabled="state.busy" t-on-click.stop="() => this.reject(r)">رفض</button>
                                    </td>
                                </tr>
                                <tr t-if="!table.rows.length"><td colspan="12" class="o_tq_empty" t-out="table.empty"/></tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
