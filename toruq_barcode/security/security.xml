<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_barcode_count_only" model="res.groups">
        <field name="name">Barcode: Count Only (Toruq)</field>
        <field name="comment">Cannot scan from the Barcode home screen, Operations button hidden. Inventory Count still works.</field>
    </record>

    <record id="group_barcode_hide_scanner" model="res.groups">
        <field name="name">Barcode: Hide Scanner Graphic (Toruq)</field>
        <field name="comment">Hides the barcode picture / "Scan or tap" block on the Barcode home screen. Can be used alone.</field>
    </record>

    <record id="group_barcode_guided_count" model="res.groups">
        <field name="name">Barcode: Guided Count Mode (Toruq)</field>
        <field name="comment">Shows one large "Start counting now" button with the number of products to count. Implies Count Only + Hide Scanner Graphic.</field>
        <field name="implied_ids" eval="[(4, ref('group_barcode_count_only')), (4, ref('group_barcode_hide_scanner'))]"/>
    </record>

    <!-- Optional hardening: INACTIVE by default. Enable only after testing POS/transfers with the count-only user. -->
    <record id="rule_quant_count_only_read" model="ir.rule">
        <field name="name">Toruq: count-only users read only quants assigned to them</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="groups" eval="[(4, ref('group_barcode_count_only'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="active" eval="False"/>
    </record>
</odoo>
