<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_toruq_count_log_list" model="ir.ui.view">
        <field name="name">toruq.count.log.list</field>
        <field name="model">toruq.count.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="event" widget="badge"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="lot_id" optional="hide"/>
                <field name="user_id"/>
                <field name="counter_id" optional="show"/>
                <field name="requester_id" optional="hide"/>
                <field name="system_qty" optional="show"/>
                <field name="counted_qty"/>
                <field name="diff_qty"/>
            </list>
        </field>
    </record>

    <record id="view_toruq_count_log_form" model="ir.ui.view">
        <field name="name">toruq.count.log.form</field>
        <field name="model">toruq.count.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="event"/>
                            <field name="product_id"/>
                            <field name="location_id"/>
                            <field name="warehouse_id"/>
                            <field name="lot_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="counter_id"/>
                            <field name="requester_id"/>
                            <field name="system_qty"/>
                            <field name="counted_qty"/>
                            <field name="diff_qty"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_toruq_count_log_search" model="ir.ui.view">
        <field name="name">toruq.count.log.search</field>
        <field name="model">toruq.count.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="user_id"/>
                <field name="counter_id"/>
                <filter name="requested" string="طلب جرد" domain="[('event', '=', 'requested')]"/>
                <filter name="submitted" string="إرسال للاعتماد" domain="[('event', '=', 'submitted')]"/>
                <filter name="applied" string="معتمد" domain="[('event', '=', 'applied')]"/>
                <filter name="rejected" string="مرفوض" domain="[('event', '=', 'rejected')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_event" string="الحدث" context="{'group_by': 'event'}"/>
                    <filter name="group_product" string="المنتج" context="{'group_by': 'product_id'}"/>
                    <filter name="group_user" string="المنفذ" context="{'group_by': 'user_id'}"/>
                    <filter name="group_warehouse" string="الفرع" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_toruq_count_log" model="ir.actions.act_window">
        <field name="name">سجل الجرد</field>
        <field name="res_model">toruq.count.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_toruq_count_log_search"/>
    </record>

    <menuitem id="menu_toruq_count_log"
              name="سجل الجرد"
              parent="stock.menu_warehouse_report"
              action="action_toruq_count_log"
              groups="stock.group_stock_manager"
              sequence="6"/>
</odoo>
