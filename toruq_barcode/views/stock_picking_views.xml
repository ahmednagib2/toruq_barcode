<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_toruq_branch" model="ir.ui.view">
        <field name="name">stock.picking.form.toruq.branch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="toruq_flow" invisible="1"/>
                <button name="action_toruq_accept_all" type="object" class="btn-primary"
                        string="قبول الكل"
                        groups="toruq_barcode.group_barcode_transfer_receiver,stock.group_stock_manager"
                        invisible="toruq_flow != 'in' or state in ('done', 'cancel')"/>
                <button name="action_toruq_confirm_receive" type="object"
                        string="تأكيد الاستلام (حسب المحدد)"
                        groups="toruq_barcode.group_barcode_transfer_receiver,stock.group_stock_manager"
                        invisible="toruq_flow != 'in' or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="حركة بين الفروع (Toruq)" invisible="toruq_flow == 'none'">
                    <group>
                        <field name="toruq_flow"/>
                        <field name="toruq_sender_id"/>
                        <field name="toruq_receiver_id"/>
                        <field name="toruq_courier"/>
                    </group>
                    <group>
                        <field name="toruq_src_warehouse_id"/>
                        <field name="toruq_dest_warehouse_id"/>
                        <field name="toruq_link_id"/>
                        <field name="toruq_reject_reason"/>
                    </group>
                </group>
                <group string="فواتير (اختياري)" invisible="toruq_flow == 'none'">
                    <field name="toruq_sender_attachment_ids" widget="many2many_binary"/>
                    <field name="toruq_receiver_attachment_ids" widget="many2many_binary"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_toruq_incoming" model="ir.actions.act_window">
        <field name="name">تحويلات واردة بانتظار استلامي</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('toruq_flow', '=', 'in'), ('state', 'not in', ('done', 'cancel')), ('toruq_receiver_id', '=', uid)]</field>
    </record>

    <record id="action_toruq_all_transfers" model="ir.actions.act_window">
        <field name="name">تحويلات الفروع</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('toruq_flow', 'in', ('out', 'in', 'return'))]</field>
    </record>

    <menuitem id="menu_toruq_incoming" name="تحويلات واردة لي"
              parent="stock.menu_stock_root" action="action_toruq_incoming" sequence="15"
              groups="toruq_barcode.group_barcode_transfer_receiver"/>
    <menuitem id="menu_toruq_all_transfers" name="تحويلات الفروع"
              parent="stock.menu_stock_root" action="action_toruq_all_transfers" sequence="16"
              groups="stock.group_stock_manager"/>
</odoo>
