<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brt_sign_wizard_form" model="ir.ui.view">
        <field name="name">brt.sign.wizard.form</field>
        <field name="model">brt.sign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="picking_id"/>
                    <field name="mode" invisible="1"/>
                    <field name="has_shortage" invisible="1"/>
                    <field name="summary"/>
                    <field name="reason" invisible="not has_shortage or mode != 'receive'"
                           required="has_shortage and mode == 'receive'"/>
                    <field name="signer_name"/>
                    <field name="signature" widget="signature"
                           options="{'full_name': 'signer_name', 'size': [420, 160]}" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" class="btn-primary" string="توقيع وتأكيد"/>
                    <button string="إلغاء" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
