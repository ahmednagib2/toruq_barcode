<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_brt" model="ir.ui.view">
        <field name="name">stock.picking.form.brt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="brt_flow" invisible="1"/>
                <button name="action_brt_accept_all" type="object" class="btn-primary"
                        string="قبول الكل والتوقيع"
                        invisible="brt_flow != 'in' or state in ('done', 'cancel')"/>
                <button name="action_brt_confirm_receive" type="object"
                        string="تأكيد الاستلام والتوقيع (حسب المحدد)"
                        invisible="brt_flow != 'in' or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="حركة بين الفروع" invisible="brt_flow == 'none'">
                    <group>
                        <field name="brt_sender_id"/>
                        <field name="brt_receiver_id"/>
                        <field name="brt_courier"/>
                        <field name="brt_link_id"/>
                    </group>
                    <group>
                        <field name="brt_src_warehouse_id"/>
                        <field name="brt_dest_warehouse_id"/>
                        <field name="brt_reject_reason"/>
                    </group>
                </group>
                <group string="التوقيعات الإلكترونية" invisible="brt_flow == 'none'">
                    <group>
                        <field name="brt_sender_signature" widget="image" options="{'size': [250, 100]}"/>
                        <field name="brt_sender_signed_by"/>
                        <field name="brt_sender_signed_at"/>
                    </group>
                    <group>
                        <field name="brt_receiver_signature" widget="image" options="{'size': [250, 100]}"/>
                        <field name="brt_receiver_signed_by"/>
                        <field name="brt_receiver_signed_at"/>
                    </group>
                </group>
                <group string="فواتير (اختياري)" invisible="brt_flow == 'none'">
                    <field name="brt_sender_attachment_ids" widget="many2many_binary"/>
                    <field name="brt_receiver_attachment_ids" widget="many2many_binary"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_brt_incoming" model="ir.actions.act_window">
        <field name="name">تحويلات واردة بانتظار استلامي</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('brt_flow', '=', 'in'), ('state', 'not in', ('done', 'cancel')), ('brt_receiver_id', '=', uid)]</field>
    </record>

    <record id="action_brt_all_transfers" model="ir.actions.act_window">
        <field name="name">كل تحويلات الفروع</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('brt_flow', 'in', ('out', 'in', 'return'))]</field>
    </record>
</odoo>
